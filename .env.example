# -------------------------------
# Pipeline
# -------------------------------
PIPELINE_NAME=Olist_ETL_Pipeline

# -------------------------------
# Source Data Paths (CSV / JSON / XML)
# -------------------------------
CUSTOMERS_PATH=C:/Users/YOU/Downloads/Olist/customers.csv
GEOLOCATION_PATH=C:/Users/YOU/Downloads/Olist/geolocation.csv

ORDERS_PATH=C:/Users/YOU/Downloads/Olist/orders.json
ORDER_ITEMS_PATH=C:/Users/YOU/Downloads/Olist/order_items.json

PRODUCTS_PATH=C:/Users/YOU/Downloads/Olist/products.xml
PRODUCT_CATEGORY_TRANSLATION_PATH=C:/Users/YOU/Downloads/Olist/product_category_translation.xml

# -------------------------------
# Processed Data Paths
# -------------------------------
BRONZE_PATH=data/bronze
SILVER_PATH=data/silver
GOLD_PATH=data/gold
REJECTED_PATH=data/rejected

# -------------------------------
# PostgreSQL Warehouse (your LOCAL Postgres instance - Gold tables
# + pipeline metadata are loaded here, never into a Docker
# container's Postgres)
# -------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=warehouse_db
DB_USER=postgres
DB_PASSWORD=your_local_postgres_password

# -------------------------------
# MySQL Source Database (order_payments, order_reviews)
# -------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=olist_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# -------------------------------
# Metadata
# -------------------------------
METADATA_TABLE=pipeline_metadata
AUDIT_TABLE=pipeline_audit

# -------------------------------
# Email
# -------------------------------
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_RECEIVER=your_email@gmail.com
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# -------------------------------
# Docker / Airflow only (not used by main.py directly)
# -------------------------------
# Folder docker-compose mounts read-only into every Airflow
# container as /opt/airflow/source_data - should be the same
# folder CUSTOMERS_PATH/ORDERS_PATH/etc. above point into.
OLIST_SOURCE_DIR=C:/Users/YOU/Downloads/Olist

# Shared secret Airflow 3 uses to sign/verify task auth tokens
# between the scheduler, dag-processor and api-server containers.
AIRFLOW_JWT_SECRET=change-this-to-a-long-random-string
